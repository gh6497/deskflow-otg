# Inspect build artifacts only; never launch ADB or access a device.
if(HAVE_SCRCPY)
  foreach(name scrcpy-server SCRCPY_VERSION.txt)
    if(NOT EXISTS "${DATA_DIR}/${name}")
      message(FATAL_ERROR "GUI runtime file missing: ${DATA_DIR}/${name}")
    endif()
  endforeach()
  file(SHA256 "${SERVER}" expected)
  file(SHA256 "${DATA_DIR}/scrcpy-server" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "GUI scrcpy-server differs from the configured runtime")
  endif()
  file(READ "${DATA_DIR}/SCRCPY_VERSION.txt" actual_version)
  string(STRIP "${actual_version}" actual_version)
  if(NOT actual_version STREQUAL VERSION)
    message(FATAL_ERROR "GUI scrcpy-server version mismatch")
  endif()
endif()
if(ADB_DIR)
  set(adb "${GUI_DIR}/platform-tools/adb${EXE_SUFFIX}")
  if(NOT EXISTS "${adb}")
    message(FATAL_ERROR "GUI bundled ADB missing: ${adb}")
  endif()
  file(SHA256 "${ADB_DIR}/adb${EXE_SUFFIX}" expected)
  file(SHA256 "${adb}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "GUI bundled ADB differs from the configured bundle")
  endif()
  if(EXE_SUFFIX STREQUAL ".exe")
    foreach(dll AdbWinApi.dll AdbWinUsbApi.dll)
      if(NOT EXISTS "${GUI_DIR}/platform-tools/${dll}")
        message(FATAL_ERROR "GUI bundled ADB DLL missing: ${dll}")
      endif()
    endforeach()
  endif()
endif()
