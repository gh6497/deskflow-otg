<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#1565C0"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/connection_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/connection_unknown"
            android:textSize="22sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/connection_help" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/setup_description"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/notification_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textSize="15sp" />

        <Button
            android:id="@+id/notification_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/open_notification_access_settings" />

        <Switch
            android:id="@+id/autoplay_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/autoplay_enabled" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/autoplay_help" />

        <TextView
            android:id="@+id/autoplay_target"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/autoplay_select_player"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/autoplay_select_player" />

        <Button
            android:id="@+id/open_transfers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/transfer_title" />
    </LinearLayout>
</ScrollView>
