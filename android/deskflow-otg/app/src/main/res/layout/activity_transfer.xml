<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/transfer_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/transfer_phone_help" />

    <Switch
        android:id="@+id/transfer_auto_public"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/transfer_auto_public" />

    <TextView
        android:id="@+id/transfer_destination"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/transfer_destination_private" />

    <Button
        android:id="@+id/transfer_choose_folder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/transfer_choose_folder" />

    <Button
        android:id="@+id/transfer_refresh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/transfer_refresh" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/transfer_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
